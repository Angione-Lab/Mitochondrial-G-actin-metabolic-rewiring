library(ggplotify)
library(heatmaply)
library(rstatix)
data <- read.csv('Results/metabolite_concentration.csv')
fasn_mets <- read.csv('Results/FASN_mets.csv', header = FALSE)
fasn_mets$V1 <-gsub("c","",as.character(fasn_mets$V1))
fasn_mets$V1 <-gsub("e","",as.character(fasn_mets$V1))
fasn_mets$V1 <-gsub("n","",as.character(fasn_mets$V1))
testmetNames = c("ethanolamine" ,"hypoxanthine" ,"butyrate" ,"choline" ,"4-aminobutanal" ,"adenine","alanine" ,"adenosine" ,"ADP" ,"alloxan" ,"AMP" ,
"arginine" ,"asparagine" ,"ATP" ,"cAMP" ,"cGMP" ,"creatine" ,"deoxyadenosine" ,"deoxyguanosine" ,"deoxyinosine" ,"galactose" ,"glutamate" ,"glycerol" ,
"guanine" ,"guanosine" ,"hyaluronate" ,"hydroxide" ,"inosine" ,"inositol" ,"L-lactate" ,"O2" ,"putrescine" ,"urate" ,
"urea" ,"serine" ,"tridecylic acid" ,"pentadecylic acid" ,"acetate" ,"Pi" ,"ornithine" ,"glycine" ,"oxalate","proline")
data <- data %>%
filter(Metabolite.Names %in% testmetNames)
#data <- data %>%
#  filter(Metabolite.ID %in% c(fasn_mets$V1))
#df$Metabolite.Names <- ordered(df$Metabolite.Names,
#                               levels = testmetNames)
#df <- df[order(df$Metabolite.Names),]
df <- data %>% select(-c('Metabolite.ID', 'GroupCount'))
row.names(df) = df$Metabolite.Names
df <- df %>% select(-c('Metabolite.Names'))
df <- data.frame(t(df), check.names = FALSE)
df$Condition <- rownames(df)
# Convert id and time into factor variables
df$Condition<-gsub("_1","",as.character(df$Condition))
df$Condition<-gsub("_2","",as.character(df$Condition))
df$Condition<-gsub("_3","",as.character(df$Condition))
df$Condition<-gsub("1","",as.character(df$Condition))
df$Condition<-gsub("2","",as.character(df$Condition))
df$Condition<-gsub("3","",as.character(df$Condition))
ann_colors = list(
Condition = c(APC_WT='#5DADE2', APC_m4='#D6EAF8'))
group <- df %>% dplyr::select('Condition')
#df <- df %>% select(-c(Condition))
sep_into_cols <- colnames(df %>% select(-c('Condition')))
pf <- df %>%
pivot_longer(
sep_into_cols,
names_to = "Metabolites",
values_to = "Concentration",
values_drop_na = TRUE
)
pf$Concentration <- as.numeric(pf$Concentration)
pwc <- pf %>%
group_by(Metabolites) %>%
pairwise_t_test(
`Concentration` ~ Condition, paired = FALSE,
p.adjust.method = "bonferroni"
)
pwc
#pwc <- pwc[pwc$Metabolites %in% testmetNames,]
pwc <- pwc[pwc$p.adj < 0.05,]
df <- df %>% select(pwc$Metabolites)
df <- t(normalize(df))
p = pheatmap(df,
annotation_col = group,
cluster_row = FALSE,
#scale = "row",
cluster_cols = FALSE,
#angle_col = 315,
annotation_colors = ann_colors,
border_color = NA,
color=colorRampPalette(c("navy", "white", "red"))(10000))
print(p)
testmetNames = c("ribose-5-phosphate","2-deoxy-D-ribose-5-phosphate","NADPH", "ethanolamine" ,"hypoxanthine" ,"butyrate" ,"choline" ,"4-aminobutanal" ,"adenine","alanine" ,"adenosine" ,"ADP" ,"alloxan" ,"AMP" ,
"arginine" ,"asparagine" ,"ATP" ,"cAMP" ,"cGMP" ,"creatine" ,"deoxyadenosine" ,"deoxyguanosine" ,"deoxyinosine" ,"galactose" ,"glutamate" ,"glycerol" ,
"guanine" ,"guanosine" ,"hyaluronate" ,"hydroxide" ,"inosine" ,"inositol" ,"L-lactate" ,"O2" ,"putrescine" ,"urate" ,
"urea" ,"serine" ,"tridecylic acid" ,"pentadecylic acid" ,"acetate" ,"Pi" ,"ornithine" ,"glycine" ,"oxalate","proline")
fasn_mets <- read.csv('Results/FASN_mets.csv', header = FALSE)
View(fasn_mets)
