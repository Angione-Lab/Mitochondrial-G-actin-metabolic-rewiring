metadata = data.frame(c('WT', 'WT', 'WT', 'M4', 'M4', 'M4'))
rownames(metadata) = colnames(gene_expr)
colnames(metadata) = c("Condition")
dds <- DESeqDataSetFromMatrix(countData= gene_expr,
colData = metadata,
design = ~Condition,
tidy = TRUE)
dds <- DESeq(dds)
res <-results(dds)
res <- res[order(res$padj),]
a <- data.frame(res)
